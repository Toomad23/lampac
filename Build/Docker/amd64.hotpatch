# Hotpatch Dockerfile — собирает только изменённые модули и накладывает поверх
# уже работающего образа. Используем когда upstream publish.zip недоступен
# (lampac-talks/lampac archived → 404) и нужен быстрый патч одного модуля.

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:6d7f69bc7bc9d4510ca255977b1f53ce52a79307e048a91450b2aecd63627cc3 AS build
WORKDIR /src

COPY Lampac.sln ./
COPY Lampac/Lampac.csproj Lampac/
COPY BaseModule/BaseModule.csproj BaseModule/
COPY Catalog/Catalog.csproj Catalog/
COPY DLNA/DLNA.csproj DLNA/
COPY JacRed/JacRed.csproj JacRed/
COPY Merchant/Merchant.csproj Merchant/
COPY Online/Online.csproj Online/
COPY Shared/Shared.csproj Shared/
COPY SISI/SISI.csproj SISI/
COPY Tracks/Tracks.csproj Tracks/
COPY TorrServer/TorrServer.csproj TorrServer/
RUN dotnet restore Online/Online.csproj \
 && dotnet restore Tracks/Tracks.csproj

COPY . .
RUN dotnet publish Online/Online.csproj -c Release -o /publish/module --no-restore \
 && dotnet publish Tracks/Tracks.csproj -c Release -o /publish/module --no-restore \
 && find /publish -name '*.pdb' -delete

# Runtime — поверх работающего образа на NAS.
FROM ghcr.io/toomad23/lampac:main
USER root
COPY --from=build /publish/module/Online.dll /home/module/Online.dll
COPY --from=build /publish/module/Tracks.dll /home/module/Tracks.dll
RUN chown 1000:1000 /home/module/Online.dll /home/module/Tracks.dll
USER 1000:1000
