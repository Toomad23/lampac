# Self-building Dockerfile — builds Lampac from this repo instead of downloading publish.zip
# Used by the GitHub Actions pipeline in .github/workflows/docker-publish.yml

# ---------- build stage ----------
# Digest captured 2026-04-22 for .NET 10.0 SDK. Pinning mutable tags protects
# the build from silent base-image swaps; bump deliberately on each release cut.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:6d7f69bc7bc9d4510ca255977b1f53ce52a79307e048a91450b2aecd63627cc3 AS build
WORKDIR /src

# Restore first for better layer caching
COPY Lampac.sln ./
COPY Lampac/Lampac.csproj Lampac/
COPY BaseModule/BaseModule.csproj BaseModule/
COPY Catalog/Catalog.csproj Catalog/
COPY DLNA/DLNA.csproj DLNA/
COPY JacRed/JacRed.csproj JacRed/
COPY Merchant/Merchant.csproj Merchant/
COPY Online/Online.csproj Online/
COPY Shared/Shared.csproj Shared/
COPY SISI/SISI.csproj SISI/
COPY Tracks/Tracks.csproj Tracks/
COPY TorrServer/TorrServer.csproj TorrServer/
RUN dotnet restore Lampac.sln

COPY . .
# Lampac.csproj only references Shared.csproj, so `dotnet publish Lampac`
# alone produces only Lampac.dll and Shared.dll.  Each module project
# (DLNA, JacRed, SISI, Catalog, TorrServer, Tracks, Online, Merchant)
# must be published separately into /publish/module/ — otherwise the
# fork's security fixes for those modules never reach the runtime
# (the upstream publish.zip ships stale upstream binaries in module/).
RUN dotnet publish Lampac/Lampac.csproj -c Release -o /publish --no-restore \
 && for proj in DLNA JacRed SISI Catalog TorrServer Tracks Online Merchant; do \
        dotnet publish $proj/$proj.csproj -c Release -o /publish/module --no-restore || exit 1; \
    done \
 && rm -rf /publish/runtimes/osx* /publish/runtimes/win* \
           /publish/runtimes/linux-arm /publish/runtimes/linux-arm64 \
           /publish/runtimes/linux-musl-arm64 /publish/runtimes/linux-musl-x64 \
           /publish/module/runtimes \
 && touch /publish/isdocker \
 && find /publish -name '*.pdb' -delete

# ---------- runtime stage ----------
# Digest captured 2026-04-21. See build-stage rationale.
FROM debian:12.5-slim@sha256:67f3931ad8cb1967beec602d8c0506af1e37e8d73c2a0b38b181ec5d8560d395
EXPOSE 9118
WORKDIR /home

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip xz-utils sed chromium xvfb libnspr4 fontconfig \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fSL -o dotnet.tar.gz https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.7/aspnetcore-runtime-10.0.7-linux-x64.tar.gz \
 && mkdir -p /usr/share/dotnet \
 && tar -oxzf dotnet.tar.gz -C /usr/share/dotnet \
 && rm dotnet.tar.gz

# Upstream publish.zip ships wwwroot/, basemod/, plugins/ and a module/
# folder that contains both third-party plugins (Lamson, Kinogram,
# TelegramBot, etc.) and stale upstream copies of OUR modules
# (DLNA.dll, JacRed.dll, SISI.dll, …).  Extract it FIRST so the COPY
# below overwrites the stale upstream module DLLs with our freshly
# built ones.  dotnet publish doesn't produce wwwroot/basemod/plugins
# either, so we still need the upstream archive for those.
RUN curl -fSL -o /tmp/publish.zip https://github.com/lampac-talks/lampac/releases/latest/download/publish.zip \
 && (unzip -o /tmp/publish.zip wwwroot/* basemod/* module/* plugins/* -d /home/ || [ $? -eq 1 ]) \
 && mkdir -p runtimes/references \
 && rm /tmp/publish.zip

COPY --from=build /publish/ /home/
RUN mkdir -p runtimes/references
COPY --from=build /src/BaseModule/Controllers/ /home/basemod/Controllers/

# Why (HIGH-8): pin TorrServer MatriX.135 and verify SHA-256.
RUN mkdir -p torrserver \
 && curl -fSL -o torrserver/TorrServer-linux https://github.com/YouROK/TorrServer/releases/download/MatriX.135/TorrServer-linux-amd64 \
 && echo "e8df23592ff44ccaf447d55adde3c625cd2d9de9b2af994aacd2e579d8ea174a  torrserver/TorrServer-linux" | sha256sum -c - \
 && chmod +x torrserver/TorrServer-linux

RUN curl -fSL https://nodejs.org/dist/v22.12.0/node-v22.12.0-linux-x64.tar.xz -o /tmp/node.tar.xz \
 && tar -xJf /tmp/node.tar.xz -C /tmp/ \
 && mkdir -p .playwright/node/linux-x64 \
 && cp /tmp/node-v22.12.0-linux-x64/bin/node .playwright/node/linux-x64/node \
 && chmod +x .playwright/node/linux-x64/node \
 && touch .playwright/node/linux-x64/node.ok \
 && rm -rf /tmp/node-v22.12.0-linux-x64 /tmp/node.tar.xz

RUN curl -fSL -o /tmp/ffmpeg.tar.xz https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz \
 && mkdir -p /tmp/ffmpeg-extract && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg-extract --strip-components=1 \
 && mkdir -p data \
 && mv /tmp/ffmpeg-extract/bin/ffmpeg  data/ffmpeg  && chmod +x data/ffmpeg \
 && mv /tmp/ffmpeg-extract/bin/ffprobe data/ffprobe && chmod +x data/ffprobe \
 && rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-extract

RUN echo '{"chromium":{"executablePath":"/usr/bin/chromium"}}' > init.conf

RUN find /home -name '*.pdb' -delete

RUN useradd -u 1000 -m app || true
RUN chown -R 1000:1000 /home
USER 1000:1000

ENTRYPOINT ["/usr/share/dotnet/dotnet", "Lampac.dll"]
